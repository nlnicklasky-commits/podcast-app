# === Required ===
ANTHROPIC_API_KEY=sk-ant-...

# === Whisper Settings ===
WHISPER_MODEL=base                    # tiny, base, small, medium, large
WHISPER_DEVICE=cpu                    # cpu, cuda, mps (Apple Silicon)

# === Embedding Settings ===
EMBEDDING_MODEL=all-MiniLM-L6-v2      # or all-mpnet-base-v2 for better quality

# === Storage Paths ===
DATABASE_URL=sqlite:///./data/podcasts.db
CHROMA_PATH=./data/chroma
AUDIO_PATH=./data/audio

# === Processing Settings ===
MAX_CONCURRENT_JOBS=2
DELETE_AUDIO_AFTER_TRANSCRIPTION=false
MAX_PODCAST_DURATION_HOURS=4          # Reject podcasts longer than this

# === Chat Settings (Phase 3) ===
CHAT_MODEL=claude-haiku               # claude-haiku, claude-sonnet, ollama/llama3
OLLAMA_BASE_URL=http://localhost:11434  # If using Ollama

# === Server Settings ===
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173    # For CORS
